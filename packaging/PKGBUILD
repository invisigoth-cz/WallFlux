# Maintainer: invisigoth-cz <invisigoth@seznam.cz>

pkgname=wallflux
pkgver=0.19.0
pkgrel=1
pkgdesc='Plays the Wallpaper Engine wallpapers you already own'
arch=('x86_64')
url='https://github.com/invisigoth-cz/WallFlux'
# The exception is for the Steamworks SDK and is spelled out in
# LICENSE-EXCEPTION, which package() installs beside the binary.
license=('GPL-3.0-or-later' 'custom:Steamworks-SDK-linking-exception')
# No LTO. makepkg's -flto reaches the C of QuickJS through CFLAGS, which
# Cargo compiles into the renderer's static library as LTO objects the
# final link cannot read: the build stops on `undefined reference to
# JS_MarkValue`. A build outside makepkg never sees the flag.
options=('!lto')

# qt6-base brings Wayland and the widgets the tray icon falls back on, and
# qt6-multimedia brings a playback backend through its own virtual
# dependency, so neither is named here. breeze-icons is: the tray icon is
# the only way to reach the picker, and it is a name out of the icon theme
# rather than a file we ship.
#
# libpulse is here for the `pactl` program rather than for the library. It
# is what tells us another program is using the speakers, and being a
# program it is not something the linker would ever mention.
#
# steamworks-sdk is Valve's own, out of the AUR, and it is the only thing
# on a Linux machine that carries libsteam_api.so -- the flat C API that
# ISteamUGC is reached through. Measured on a machine with both Steam and
# Wallpaper Engine installed: Steam ships no libsteam_api.so at all, the
# Wallpaper Engine folder holds only the Windows steam_api.dll, and
# Steam's own steamclient.so exports CreateInterface and not one
# SteamAPI_* symbol. So without this package the workshop tab can say
# nothing except that it cannot ask, which is why it is a dependency and
# not an optional one.
#
# It is also the only way the SDK can arrive here without WallFlux being
# the one to hand it on: that package puts it under /opt in its entirety,
# unmodified, with Valve's own licence beside it, which is what the SDK's
# terms require and what shipping it inside this package would break. An
# AUR helper resolves it like any other AUR dependency; plain makepkg -si
# will say it cannot find it and want it built first.
# ffmpeg is here for the programs rather than the libraries, as libpulse is
# for pactl: ffprobe reads a video wallpaper's size, and a scene's own
# videos are decoded by ffmpeg run beside the renderer. qt6-multimedia
# brings it too, but that is its business; this is ours.
depends=('breeze-icons' 'ffmpeg' 'layer-shell-qt' 'libpulse' 'qt6-base'
         'qt6-declarative' 'qt6-multimedia' 'qt6-webengine'
         'steamworks-sdk')
# qt6-tools is here for lrelease, which compiles the Czech catalogue into the
# binary at build time. Nothing needs it afterwards.
#
# cargo builds the scene renderer under crates/ into a static library that
# goes inside the binary, so it is needed to build and never to run.
makedepends=('cargo' 'cmake' 'git' 'ninja' 'qt6-tools')

# Not a dependency of running: WallFlux reads the folder Steam has already
# filled and needs nothing of Steam's while it plays. It is a dependency of
# having anything to play, since Wallpaper Engine is bought through Steam and
# a workshop item for a paid app can only be fetched by an account that owns
# it. Anyone who already has the folder does not need this installed.
optdepends=('steam: to install Wallpaper Engine and fetch wallpapers from its workshop')

# Built from this checkout rather than from the remote, so what is packaged
# is what is in front of you -- committed, though: the clone cannot see
# anything still sitting in the working tree.
#
# This file lives in a directory of its own because makepkg works in src/
# and pkg/ beside it, and the project already has a src/ holding the
# program. Run from the project root, makepkg -C would empty it.
source=("$pkgname::git+file://$startdir/..")
sha256sums=('SKIP')

# The renderer's crates are fetched here, where makepkg allows the network,
# so that the build itself can be held to exactly what Cargo.lock says.
prepare() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    export RUSTUP_TOOLCHAIN=stable
    cmake -S "$pkgname" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DWALLFLUX_CARGO_FLAGS=--frozen
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    # The added permission travels with the binary it applies to.
    install -Dm644 "$pkgname/LICENSE-EXCEPTION" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE-EXCEPTION"
}
